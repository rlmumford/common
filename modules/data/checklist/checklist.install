<?php

/**
 * @file
 * Installs and updates checklist storage.
 */

use Drupal\checklist\Entity\ChecklistItem;
use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\Core\Field\FieldStorageDefinitionInterface;
use Drupal\Core\StringTranslation\TranslatableMarkup;

/**
 * Install the outcomes field.
 */
function checklist_update_8100() {
  \Drupal::entityDefinitionUpdateManager()->installFieldStorageDefinition(
    'outcomes',
    'checklist_item',
    'checklist',
    BaseFieldDefinition::create('typed_data_reference')
      ->setLabel(new TranslatableMarkup('Contexts'))
      ->setCardinality(FieldStorageDefinitionInterface::CARDINALITY_UNLIMITED)
  );
}

/**
 * Adds opt-in working state without changing existing item outcomes.
 */
function checklist_update_10001() {
  $manager = \Drupal::entityDefinitionUpdateManager();
  if (!$manager->getFieldStorageDefinition('state', 'checklist_item')) {
    $definition = ChecklistItem::baseFieldDefinitions(
      \Drupal::entityTypeManager()->getDefinition('checklist_item')
    )['state'];
    $manager->installFieldStorageDefinition('state', 'checklist_item', 'checklist', $definition);
  }
}

/**
 * Implements hook_schema().
 */
function checklist_schema() {
  $uuid = ['type' => 'varchar_ascii', 'length' => 36, 'not null' => TRUE];
  $number = ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE];
  $timestamp = ['type' => 'int', 'size' => 'big', 'not null' => TRUE];
  $status = ['type' => 'varchar_ascii', 'length' => 16, 'not null' => TRUE];
  $schema['checklist_attempt'] = [
    'description' => 'Current metadata for each execution attempt; terminal attempts remain immutable.',
    'fields' => [
      'id' => $uuid,
      'item_uuid' => $uuid,
      'previous' => ['not null' => FALSE] + $uuid,
      'mode' => $status,
      'status' => $status,
      'version' => $number,
      'initiator' => $number,
      'executor' => $number,
      'path' => $status,
      'operation' => ['type' => 'varchar', 'length' => 128, 'not null' => FALSE],
      'created' => $timestamp,
      'changed' => $timestamp,
    ],
    'primary key' => ['id'],
    'indexes' => ['item_uuid' => ['item_uuid']],
  ];
  $schema['checklist_attempt_head'] = [
    'description' => 'Atomically replaced latest-attempt pointer per checklist item UUID.',
    'fields' => ['item_uuid' => $uuid, 'attempt' => $uuid],
    'primary key' => ['item_uuid'],
  ];
  $schema['checklist_attempt_event'] = [
    'description' => 'Append-only attempt transition metadata, without raw working state.',
    'fields' => [
      'attempt' => $uuid,
      'version' => $number,
      'from_status' => ['not null' => FALSE] + $status,
      'to_status' => $status,
      'actor' => $number,
      'created' => $timestamp,
      'reason' => ['type' => 'varchar', 'length' => 512, 'not null' => TRUE, 'default' => ''],
    ],
    'primary key' => ['attempt', 'version'],
  ];
  return $schema;
}

/**
 * Adds attempt storage without inventing history for existing items.
 */
function checklist_update_10002() {
  $schema = \Drupal::database()->schema();
  foreach (checklist_schema() as $table => $definition) {
    if (!$schema->tableExists($table)) {
      $schema->createTable($table, $definition);
    }
  }
}
