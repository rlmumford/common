<?php

/**
 * @file
 * Records document relationships and exposes related work through Views.
 */

use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\task\TaskInterface;

/**
 * Implements hook_entity_insert().
 */
function document_task_links_entity_insert(EntityInterface $entity): void {
  if (in_array($entity->getEntityTypeId(), ['task', 'checklist_item'], TRUE)) {
    \Drupal::service('document_task_links.index')->synchronize($entity);
  }
}

/**
 * Implements hook_entity_update().
 */
function document_task_links_entity_update(EntityInterface $entity): void {
  document_task_links_entity_insert($entity);
}

/**
 * Implements hook_entity_delete().
 */
function document_task_links_entity_delete(EntityInterface $entity): void {
  if (in_array($entity->getEntityTypeId(), ['task', 'checklist_item', 'document'], TRUE)) {
    \Drupal::service('document_task_links.index')->delete($entity);
  }
}

/**
 * Implements hook_cron().
 */
function document_task_links_cron(): void {
  $state = \Drupal::state();
  $progress = $state->get('document_task_links.backfill', []);
  $lock = \Drupal::lock();
  if (!$progress || !$lock->acquire('document_task_links.backfill', 120)) {
    return;
  }
  try {
    foreach ($progress as $type => $after) {
      $next = \Drupal::service('document_task_links.index')->backfill($type, $after);
      if ($next === NULL) {
        unset($progress[$type]);
      }
      else {
        $progress[$type] = $next;
      }
    }
    $state->set('document_task_links.backfill', $progress);
  }
  finally {
    $lock->release('document_task_links.backfill');
  }
}

/**
 * Implements hook_entity_extra_field_info().
 */
function document_task_links_entity_extra_field_info(): array {
  $fields = [];
  foreach (\Drupal::service('entity_type.bundle.info')->getBundleInfo('document') as $bundle => $info) {
    $fields['document'][$bundle]['display']['related_tasks'] = [
      'label' => t('Related tasks'),
      'weight' => 30,
      'visible' => TRUE,
    ];
  }
  return $fields;
}

/**
 * Implements hook_document_view().
 */
function document_task_links_document_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode): void {
  if ($display->getComponent('related_tasks') && $entity->access('view')) {
    $build['related_tasks'] = [
      '#type' => 'details',
      '#title' => t('Related tasks'),
      '#open' => TRUE,
      '#cache' => ['max-age' => 0],
      'tasks' => [
        '#type' => 'view',
        '#name' => 'document_related_tasks',
        '#display_id' => 'embed',
        '#arguments' => [(string) $entity->id()],
      ],
    ];
  }
}

/**
 * Implements hook_task_ui_task_summary_alter().
 */
function document_task_links_task_ui_task_summary_alter(array &$build, TaskInterface $task): void {
  $build['documents'] = \Drupal::service('document_task_links.presentation')->documents($task);
}

/**
 * Implements hook_views_data_alter().
 */
function document_task_links_views_data_alter(array &$data): void {
  $data['task']['document_task_links'] = [
    'title' => t('Related document'),
    'argument' => ['id' => 'document_task_links', 'real field' => 'id'],
    'field' => ['id' => 'document_task_links', 'real field' => 'id'],
  ];
}
