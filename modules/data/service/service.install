<?php

/**
 * @file
 * Installs and updates service storage.
 */

use Drupal\Core\Config\FileStorage;
use Drupal\Core\Field\BaseFieldDefinition;

/**
 * Implements hook_install().
 */
function service_install() {
  \Drupal::database()->insert('service_hierarchy_lock')->fields(['id' => 1])->execute();
  $service_field = BaseFieldDefinition::create('service_reference')
    ->setLabel(t('Service'))
    ->setRevisionable(TRUE)
    ->setSetting('target_type', 'service')
    ->setDisplayOptions('view', [
      'label' => 'inline',
      'type' => 'entity_reference_label',
    ])
    ->setDisplayOptions('form', [
      'type' => 'entity_reference_autocomplete',
    ])
    ->setDisplayConfigurable('view', TRUE)
    ->setDisplayConfigurable('form', TRUE);

  if (\Drupal::moduleHandler()->moduleExists('task')) {
    \Drupal::entityDefinitionUpdateManager()->installFieldStorageDefinition(
      'service',
      'task',
      'service',
      $service_field
    );
  }

  if (\Drupal::moduleHandler()->moduleExists('communication')) {
    \Drupal::entityDefinitionUpdateManager()->installFieldStorageDefinition(
      'service',
      'communication',
      'service',
      $service_field
    );
  }
}

/**
 * Add label field.
 */
function service_update_8001() {
  $fields['label'] = BaseFieldDefinition::create('string')
    ->setLabel(t('Title'))
    ->setRevisionable(TRUE)
    ->setDefaultValueCallback('\Drupal\service\Entity\Service::createLabel')
    ->setDisplayConfigurable('view', TRUE);

  $manager = \Drupal::entityDefinitionUpdateManager();
  foreach ($fields as $field_name => $definition) {
    $manager->installFieldStorageDefinition($field_name, 'service', 'service', $definition);
  }

  // Install configuration.
  $source = new FileStorage(drupal_get_path('module', 'service') . '/config/install');
  /** @var \Drupal\Core\Config\StorageInterface $config_storage */
  $config_storage = \Drupal::service('config.storage');

  $configs_to_install = [
    'views.view.services',
  ];
  foreach ($configs_to_install as $name) {
    $config_storage->write($name, $source->read($name));
  }
}

/**
 * Update services view for permissions.
 */
function service_update_8002() {
  // Install configuration.
  $source = new FileStorage(drupal_get_path('module', 'service') . '/config/install');
  /** @var \Drupal\Core\Config\StorageInterface $config_storage */
  $config_storage = \Drupal::service('config.storage');

  $configs_to_install = [
    'views.view.services',
  ];
  foreach ($configs_to_install as $name) {
    $config_storage->write($name, $source->read($name));
  }
}

/**
 * Install service field on communication entity if module installed.
 */
function service_update_8003() {
  $service_field = BaseFieldDefinition::create('service_reference')
    ->setLabel(t('Service'))
    ->setRevisionable(TRUE)
    ->setSetting('target_type', 'service')
    ->setDisplayOptions('view', [
      'label' => 'inline',
      'type' => 'entity_reference_label',
    ])
    ->setDisplayOptions('form', [
      'type' => 'entity_reference_autocomplete',
    ])
    ->setDisplayConfigurable('view', TRUE)
    ->setDisplayConfigurable('form', TRUE);

  if (\Drupal::moduleHandler()->moduleExists('communication')) {
    \Drupal::entityDefinitionUpdateManager()->installFieldStorageDefinition(
      'service',
      'communication',
      'service',
      $service_field
    );
  }
}

/**
 * Implements hook_schema().
 */
function service_schema() {
  return [
    'service_hierarchy_lock' => [
      'description' => 'Single mutex row for transactional service hierarchy writes.',
      'fields' => [
        'id' => ['type' => 'int', 'not null' => TRUE],
      ],
      'primary key' => ['id'],
    ],
  ];
}

/**
 * Install the hierarchy transaction mutex without changing service data.
 */
function service_update_10001() {
  $database = \Drupal::database();
  if (!$database->schema()->tableExists('service_hierarchy_lock')) {
    $database->schema()->createTable('service_hierarchy_lock', service_schema()['service_hierarchy_lock']);
  }
  $database->merge('service_hierarchy_lock')->key('id', 1)->execute();
}

/**
 * Add explicit service statuses, preserving ambiguous inactive history.
 */
function service_update_10002() {
  // Older standalone service installs did not require the Options field types.
  if (!\Drupal::moduleHandler()->moduleExists('options')) {
    \Drupal::service('module_installer')->install(['options']);
  }
  $definition = BaseFieldDefinition::create('list_string')
    ->setLabel(t('Status'))
    ->setRevisionable(TRUE)
    ->setRequired(TRUE)
    ->setSetting('allowed_values_function', '\\Drupal\\service\\Entity\\Service::statusOptionsList')
    ->setDefaultValue('draft')
    ->setInitialValue(NULL);
  $manager = \Drupal::entityDefinitionUpdateManager();
  if (!$manager->getFieldStorageDefinition('status', 'service')) {
    $manager->installFieldStorageDefinition('status', 'service', 'service', $definition);
  }

  // Update each revision from its own boolean, never from today's entity state.
  // NULL deliberately identifies records still awaiting an explicit mapping.
  $database = \Drupal::database();
  foreach (['service', 'service_revision'] as $table) {
    $database->update($table)
      ->fields(['status' => 'active'])
      ->condition('state', 1)
      ->isNull('status')
      ->execute();
  }
  \Drupal::entityTypeManager()->getStorage('service')->resetCache();
  $unmapped = $database->select('service', 's')->isNull('status')->countQuery()->execute()->fetchField();
  return t('Service status installed. @count current services still require explicit status mapping. Legacy state and unmapped revision history are preserved.', ['@count' => $unmapped]);
}
