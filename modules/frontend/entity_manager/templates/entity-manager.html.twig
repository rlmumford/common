<div class="entity-manager" data-entity-manager>
  <div class="entity-manager__list">{{ table }}</div>
  <section class="entity-manager__reader" hidden aria-label="{{ 'Selected record'|t }}">
    <div class="entity-manager__toolbar">
      <button type="button" class="entity-manager__control entity-manager__back" data-entity-manager-close aria-label="{{ 'Back to list'|t }}" title="{{ 'Back to list'|t }}">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m12 5-7 7 7 7M5 12h15"/></svg>
      </button>
      <a class="entity-manager__control" data-entity-manager-open aria-label="{{ 'Open full page'|t }}" title="{{ 'Open full page'|t }}">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M14 3h7v7m0-7L10 14M10 5H4v15h15v-6"/></svg>
      </a>
      <button type="button" class="entity-manager__control entity-manager__close" data-entity-manager-close aria-label="{{ 'Close preview'|t }}" title="{{ 'Close preview'|t }}">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m6 6 12 12M6 18 18 6"/></svg>
      </button>
    </div>
    <p role="status" data-entity-manager-status></p>
    <div id="{{ reader_id }}" data-entity-manager-content></div>
  </section>
</div>
