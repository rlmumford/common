<?php

/**
 * @file
 * Shared entity-reader presentation for Views tables.
 */

use Drupal\Core\Entity\ContentEntityInterface;
use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Url;
use Drupal\entity_manager\Plugin\views\style\EntityManager;

/**
 * Implements hook_theme().
 */
function entity_manager_theme(): array {
  return ['entity_manager' => ['variables' => ['table' => [], 'reader_id' => '']]];
}

/**
 * Implements hook_preprocess_views_view_table().
 */
function entity_manager_preprocess_views_view_table(array &$variables): void {
  $view = $variables['view'];
  if (!$view->style_plugin instanceof EntityManager) {
    return;
  }
  foreach ($variables['rows'] as $index => &$row) {
    $entity = $variables['result'][$index]->_entity ?? NULL;
    if (!$entity instanceof ContentEntityInterface || !$entity->hasLinkTemplate('canonical')) {
      continue;
    }
    $access = $entity->access('view', NULL, TRUE);
    CacheableMetadata::createFromRenderArray($view->element)
      ->addCacheableDependency($entity)->addCacheableDependency($access)->applyTo($view->element);
    if (!$access->isAllowed()) {
      continue;
    }
    $row['attributes']->setAttribute('data-entity-manager-url', Url::fromRoute('entity_manager.preview', [
      'view_id' => $view->id(),
      'display_id' => $view->current_display,
      'entity_id' => $entity->id(),
    ])->toString());
    $row['attributes']->setAttribute('data-entity-manager-canonical', $entity->toUrl()->toString());
    $row['attributes']->setAttribute('data-entity-manager-label', (string) $entity->label());
    $row['attributes']->setAttribute('data-entity-manager-id', (string) $entity->id());
  }
  unset($row);
}
