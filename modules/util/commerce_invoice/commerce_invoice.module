<?php

use Drupal\commerce_invoice\Form\InvoiceGenerateForm;
use Drupal\Core\Datetime\DrupalDateTime;
use Drupal\Core\Entity\ContentEntityInterface;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Field\FieldDefinitionInterface;

/**
 * Implements hook_entity_view_alter().
 */
function commerce_invoice_commerce_order_view_alter(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display) {
  if ($build['#view_mode'] === 'admin') {
    $build['invoice_generate'] = \Drupal::formBuilder()->getForm(InvoiceGenerateForm::class, $entity);
  }
}

/**
 * Implements hook_theme_registry_alter().
 */
function commerce_invoice_theme_registry_alter(&$theme_registry) {
  $path = \Drupal::service('extension.path.resolver')->getPath('module', 'commerce_invoice');

  $theme_registry['commerce_order__admin']['path'] = $path.'/templates';
}

/**
 * Delivers the default value for the payment_due_date field.
 *
 * @param \Drupal\Core\Entity\ContentEntityInterface $entity
 *   The entity being created.
 * @param \Drupal\Core\Field\FieldDefinitionInterface $definition
 *   The field definition.
 *
 * @return array
 *   Array providing, for each delta item, initial values for the field's
 *   properties.
 *
 * @see \Drupal\Core\Field\FieldConfigBase::getDefaultValue()
 */
function order_payment_due_date_default_value(ContentEntityInterface $entity, FieldDefinitionInterface $definition) {

  $placed_date = DrupalDateTime::createFromTimestamp($entity->getPlacedTime() ?? time());
  $payment_due_date = $placed_date->add(new DateInterval('P1D'))->format('Y-m-d');

  return [
    ['value' => $payment_due_date],
  ];
}

/**
 * Implements hook_mail_alter().
 *
 * Attach invoice to order receipt email.
 */
function commerce_invoice_mail_alter(&$message) {
  if ($message['id'] == 'commerce_order_receipt') {
    /** @var \Drupal\commerce_order\Entity\OrderInterface $order */
    $order = $message['params']['order'];

    if (!$order->get('invoice_pdf')->isEmpty()) {
      /** @var \Drupal\file\FileInterface $file */
      $file = $order->get('invoice_pdf')->entity;
      // Mime Mail drops private filepath attachments unless the current user
      // can send arbitrary files. Receipts also run as customers or from a
      // queue: attach only this server-selected order invoice as content.
      $contents = @file_get_contents($file->getFileUri());
      if ($contents === FALSE) {
        \Drupal::logger('commerce_invoice')->error('Cannot send receipt for order @order: invoice @file is unreadable.', [
          '@order' => $order->id(),
          '@file' => $file->id(),
        ]);
        $message['send'] = FALSE;
        return;
      }
      $message['params']['attachments'][] = [
        'filecontent' => $contents,
        'filename' => $file->getFilename(),
        'filemime' => $file->getMimeType(),
      ];
    }
  }
}
