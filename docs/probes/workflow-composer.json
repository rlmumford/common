{
  "name": "rlmumford/workflow-compatibility-probe",
  "repositories": [
    {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    }
  ],
  "require": {
    "drupal/core": "~10.6.0",
    "drupal/ai": "1.4.8",
    "drupal/ai_agents": "1.3.5",
    "drupal/sm": "0.2.0",
    "drupal/tool": "1.0.0-beta8",
    "drupal/typed_data": "2.1.1",
    "drupal/entity_template": "1.0.0-alpha17"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "platform": {
      "php": "8.3.0"
    },
    "allow-plugins": false
  }
}
